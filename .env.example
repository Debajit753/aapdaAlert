# Copy this file to .env for local development. Never commit .env.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the Gemini model (check the exact ID in Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: AI voice models (tried in order) and voice name
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Sulafat

# Firebase service account JSON for Firestore, pasted on ONE line.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Leave empty to use the built-in demo store (data is kept in memory / data/dev-db.json).
FIREBASE_SERVICE_ACCOUNT=
